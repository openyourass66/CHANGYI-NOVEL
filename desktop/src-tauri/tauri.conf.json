{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "长亿",
  "mainBinaryName": "changyi",
  "version": "0.2.13",
  "identifier": "com.changyi.novel.preview",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "长亿",
        "width": 1280,
        "height": 860,
        "minWidth": 860,
        "minHeight": 600,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/app-icon-v2.ico",
      "icons/app-icon-v2.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "shortDescription": "长亿小说理解与续写工作台",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/openyourass66/CHANGYI-NOVEL/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2RTAwMjA3MEM2RjNFMDUKUldRRlBtOE1Cd0xnNWpqNWVPT2NkRFA0cVJybldiUFFvY29FcVdMbUVlazVyeHBXS2tqNFQxa3EK"
    }
  }
}
