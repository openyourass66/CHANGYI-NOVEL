{
  "name": "changyi-native-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:dist": "tauri build --bundles nsis",
    "test": "vitest run src/",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "test:e2e": "cargo build --manifest-path src-tauri/Cargo.toml --example test-workspace --no-default-features && playwright test"
  },
  "dependencies": {
    "@fontsource/geist": "^5.2.0",
    "@fontsource/geist-mono": "^5.2.0",
    "@tauri-apps/api": "^2",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jschardet": "^3.1.4",
    "jszip": "^3.10.2",
    "lucide-react": "^1.56.0",
    "mammoth": "^1.13.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.4.299",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^7",
    "vitest": "^3"
  },
  "packageManager": "pnpm@11.1.1"
}
