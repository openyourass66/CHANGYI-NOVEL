{
  "name": "changyi-desktop",
  "productName": "长忆",
  "description": "长忆 Windows 小说理解与续写客户端",
  "author": "Changyi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "pack:win": "pnpm build && electron-builder --win nsis --x64 --publish never && node scripts/verify-package.mjs",
    "check": "node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/get": "5.1.0",
    "@tailwindcss/vite": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "cn.changyi.desktop",
    "productName": "长忆",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!electron/smoke.mjs",
      "!electron/integration.mjs",
      "!node_modules/**"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Changyi-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "electronDist": "node_modules/electron/dist"
  }
}
