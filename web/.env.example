# 数据库（SQLite 相对路径基于 prisma/ 目录解析）
DATABASE_URL="file:../data/app.db"

# 模型密钥本机加密所用主密钥：32 字节 = 64 位十六进制字符
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 该密钥仅在本机使用，切勿提交或写入项目导出。
APP_ENCRYPTION_KEY="replace-with-64-hex-chars"

# 账号会话签名密钥（独立生成，至少 32 字符），访问地址必须与浏览器一致
BETTER_AUTH_SECRET="replace-with-an-independent-64-hex-secret"
BETTER_AUTH_URL="http://localhost:3000"
ADMIN_CONSOLE_URL="http://localhost:3001"
ADMIN_API_BASE_URL="http://localhost:3000"
ADMIN_BIND_ADDRESS="127.0.0.1"
ADMIN_PORT=3001
DATABASE_PROVIDER="sqlite"
ALLOW_SERVER_LOCAL_MODELS="true"

# 本机 Redis；认证验证码、会话缓存和限流状态保存在 Redis
REDIS_URL="redis://127.0.0.1:6379"

# 网易邮箱客户端授权码（不是网页登录密码）；验证与密码找回邮件不写入日志
SMTP_HOST="smtp.163.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-account@163.com"
SMTP_PASSWORD="replace-with-smtp-authorization-code"
SMTP_FROM="your-account@163.com"

# 阿里云 OSS 私有 Bucket；AccessKey 仅由服务端读取，切勿提交到 Git。
OSS_REGION="oss-cn-beijing"
OSS_BUCKET="changyi-novel"
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
