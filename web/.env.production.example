# Template only: copy to .env.vm, then keep the filled .env.vm private and out of Git.
POSTGRES_DB=changyi
POSTGRES_USER=changyi
POSTGRES_PASSWORD=replace-with-64-hex-characters
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# 32 random bytes encoded as 64 hexadecimal characters.
APP_ENCRYPTION_KEY=replace-with-64-hex-characters
BETTER_AUTH_SECRET=replace-with-an-independent-64-hex-secret
# 如使用 host-only IP，在这里填写浏览器使用的完整访问地址。
BETTER_AUTH_URL=http://localhost:3000
# 虚拟机现有 Redis；Docker Compose 将 host.docker.internal 映射到宿主机
REDIS_URL=redis://host.docker.internal:6379
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@163.com
SMTP_PASSWORD=replace-with-smtp-authorization-code
SMTP_FROM=your-account@163.com
# Aliyun OSS private avatar storage (AccessKey stays server-side).
OSS_REGION=oss-cn-beijing
OSS_BUCKET=changyi-novel
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
